# MontageAI — المتغيرات البيئية المطلوبة (انسخ هذا الملف إلى .env.local واملأ القيم)

# مفتاح OpenAI-compatible للذكاء الاصطناعي (Whisper، تحليل، عناوين، خطط المونتاج...)
# يمكن إدخاله أيضاً من واجهة "إعدادات API" داخل التطبيق.
# مثال مزودات تعمل بالكامل:
#   Groq:     OPENCODE_API_KEY=gsk_...  + OPENCODE_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI:   OPENCODE_API_KEY=sk-...   + OPENCODE_BASE_URL=https://api.openai.com/v1
#   Gemini:   OPENCODE_API_KEY=AIza...  + OPENCODE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENCODE_API_KEY=

# عنوان الخادم الأساسي (اختياري — الافتراضي https://zen.opencode.ai/v1)
# OPENCODE_BASE_URL=https://api.groq.com/openai/v1

# موديل المحادثة/التحليل (افتراضي gpt-4o) — مثال Groq: llama-3.3-70b-versatile
# OPENCODE_MODEL=

# موديل الرؤية للفريمات/الصور (افتراضي gpt-4o) — مثال Groq: qwen/qwen3.6-27b
# OPENCODE_VISION_MODEL=

# موديل التفريغ الصوتي Whisper (افتراضي whisper-1) — مثال Groq: whisper-large-v3-turbo
# WHISPER_MODEL=

# مفتاح Hugging Face لخدمات الترجمة وتوليد الصور (اختياري)
HF_TOKEN=

# مفتاح Pexels لمكتبة الصور (اختياري)
PEXELS_API_KEY=

# مسار ثابت لـ ffmpeg (اختياري — يُكتشف تلقائياً)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# مسار ثابت لثنائية auto-editor (اختياري) — إن غاب، تُنزَّل تلقائياً إلى
# .montage_ai/bin/ عبر: python scripts/install-auto-editor.py
# AUTO_EDITOR_PATH=C:\tools\auto-editor.exe

# ---------- ضابط التكلفة (Cost Guard) ----------
# سقف الإنفاق الكلي بالدولار قبل رفض الاستدعاءات المدفوعة (افتراضي 5). 0 = بلا سقف.
# MONTAGE_BUDGET_CAP=5
# أسعار تقديرية قابلة للتهيئة (اختياري — لها افتراضيات معقولة):
# COST_CHAT_PER_1K=0.005          # لكل 1000 توكن (chat)
# COST_VISION_PER_1K=0.01         # لكل 1000 توكن (رؤية)
# COST_WHISPER_PER_MIN=0.006      # لكل دقيقة صوت (تفريغ)
# COST_TTS_PER_1K_CHARS=0.015     # لكل 1000 حرف (TTS)

# ---------- حدود الرفع ----------
# الحد الأقصى لحجم الملف المرفوع بالبايت (افتراضي 2GB).
# MAX_UPLOAD_BYTES=2147483648

# ---------- خادم MCP ومساحة العمل (انظر docs/MCP_SETUP.md) ----------
# جذر مساحة العمل على الخادم (مشاريع MCP + وسائطها + الرندرات + سجل التدقيق).
# MONTAGE_WORKSPACE=.montage_ai/workspace
# مجلدات إضافية يُسمح باستيراد الوسائط منها (مفصولة بـ : أو ; على Windows). inbox مسموح دائماً.
# MONTAGE_MEDIA_ROOTS=/home/me/Videos
# الموافقة على العمليات المكلفة/المدمّرة: elicit (افتراضي) | auto | deny
# MONTAGE_MCP_APPROVAL=elicit
# MONTAGE_MAX_RENDER_JOBS=2
# MONTAGE_PLAN_TIMEOUT_MS=600000
# MONTAGE_PYTHON=python3
# FFPROBE_PATH=

# ---------- حارس الـ API المحلي ----------
# مضيفات إضافية مسموحة غير localhost (لا تنشر بلا مصادقة أمامية).
# MONTAGE_ALLOWED_HOSTS=studio.lan

# ---------- الأمان (المرحلة 2 — انظر docs/security/SECURITY_REMEDIATION_REPORT.md) ----------
# رمز وصول لكل /api (≥16 حرفاً). عند ضبطه: Authorization: Bearer <token> أو x-montage-token أو كوكي montage_token.
# إلزامي عند MONTAGE_ALLOWED_HOSTS (النشر عن بُعد بلا رمز ⇒ كل الطلبات 503). في الواجهة: يُحفظ في localStorage
# تحت المفتاح MONTAGE_API_TOKEN ويُرسل كترويسة. أنشئه بـ: openssl rand -hex 24
# MONTAGE_API_TOKEN=
# مفاتيح المزوّد من المتصفح (x-opencode-key...) تُتجاهل تلقائياً في النشر عن بُعد؛ 0 = تجاهلها دائماً (مفاتيح الخادم فقط).
# MONTAGE_ACCEPT_CLIENT_KEYS=1
# سقف التخزين الكلي لمجلدات uploads/exports/pipeline بالبايت (افتراضي 20GB) — تجاوزه ⇒ 507.
# MONTAGE_MAX_STORAGE_BYTES=21474836480
# أعمار الاحتفاظ بالساعات قبل التنظيف التلقائي/pnpm cleanup (لا يمسّ مساحة عمل المشاريع).
# MONTAGE_UPLOAD_TTL_HOURS=24
# MONTAGE_EXPORT_TTL_HOURS=72
# MONTAGE_PIPELINE_TTL_HOURS=48
# حدود موارد عمليات FFmpeg/Python (Linux عبر prlimit): off لتعطيلها.
# MONTAGE_PROC_LIMITS=on
# MONTAGE_PROC_CPU_SECONDS=115200
# MONTAGE_PROC_MAX_FILE_BYTES=17179869184
# MONTAGE_PROC_MAX_OPEN_FILES=4096
# مستوى السجلات المهيكلة (JSON إلى stderr): debug|info|warn|error|silent
# MONTAGE_LOG_LEVEL=info
